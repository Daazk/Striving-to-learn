# Postgres (контейнер db)
POSTGRES_DB=db_name
POSTGRES_USER=db_user
POSTGRES_PASSWORD=db_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis (контейнер cache)
REDIS_HOST=cache
REDIS_PORT=6379

# JWT-сервис.
# DATABASE_URL / TEST_DATABASE_URL нужны для локального запуска (uvicorn, pytest).
# В Docker DATABASE_URL собирается в compose.yaml из POSTGRES_* и указывает на хост db.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/DB_NAME
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/TEST_DB_NAME
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
